<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.mdp.eventos.view.cliente.BuscadorEventosView">
  <grid id="b1000" binding="rootPanel" layout-manager="GridLayoutManager" row-count="7" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
    <margin top="0" left="20" bottom="18" right="20"/>
    <constraints><xy x="20" y="20" width="1240" height="780"/></constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="b1001" class="javax.swing.JLabel">
        <constraints><grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints>
        <properties><text value="Eventos MDP  |  Buscar lugares  |  Sesión del cliente"/></properties>
      </component>
      <grid id="b1002" binding="panelFiltros" layout-manager="GridLayoutManager" row-count="3" column-count="7" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
        <margin top="10" left="12" bottom="12" right="12"/>
        <constraints><grid row="1" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
        <border type="line" title="Filtros de búsqueda"/>
        <children>
          <component id="b1003" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Tipo de evento"/></properties></component>
          <component id="b1004" class="javax.swing.JLabel"><constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Invitados"/></properties></component>
          <component id="b1005" class="javax.swing.JLabel"><constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha"/></properties></component>
          <component id="b1006" class="javax.swing.JLabel"><constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Hora inicio"/></properties></component>
          <component id="b1007" class="javax.swing.JLabel"><constraints><grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Hora fin"/></properties></component>
          <component id="b1008" class="javax.swing.JLabel"><constraints><grid row="0" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Zona"/></properties></component>
          <component id="b1009" class="javax.swing.JLabel"><constraints><grid row="0" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value=""/></properties></component>
          <component id="b1010" class="javax.swing.JComboBox" binding="cmbTipoEvento"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="b1011" class="javax.swing.JSpinner" binding="spnInvitados"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="b1012" class="javax.swing.JTextField" binding="txtFecha"><constraints><grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="b1013" class="javax.swing.JTextField" binding="txtHoraInicio"><constraints><grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="b1014" class="javax.swing.JTextField" binding="txtHoraFin"><constraints><grid row="1" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="b1015" class="javax.swing.JComboBox" binding="cmbZona"><constraints><grid row="1" column="5" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
          <component id="b1016" class="javax.swing.JButton" binding="btnBuscar"><constraints><grid row="1" column="6" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar lugares"/></properties></component>
          <component id="b1029" class="javax.swing.JLabel" binding="lblErrorInvitados"><constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value=" "/></properties></component>
        </children>
      </grid>
      <component id="b1017" class="javax.swing.JLabel" binding="lblHorario"><constraints><grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Horario seleccionado: HH:mm–HH:mm (+1 día) si corresponde"/></properties></component>
      <component id="b1018" class="javax.swing.JLabel"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Ordenar por"/></properties></component>
      <component id="b1019" class="javax.swing.JComboBox" binding="cmbOrden"><constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="4" fill="0" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <scrollpane id="b1020" binding="scrollResultados">
        <constraints><grid row="4" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="line"/>
        <children><component id="b1021" class="javax.swing.JTable" binding="tblResultados"><constraints/><properties/></component></children>
      </scrollpane>
      <component id="b1022" class="javax.swing.JLabel" binding="lblAtribucion"><constraints><grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Disponibilidad y tarifas informadas por los establecimientos"/></properties></component>
      <component id="b1023" class="javax.swing.JLabel" binding="lblUltimaConsulta"><constraints><grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Última consulta: —"/></properties></component>
      <grid id="b1024" binding="panelAcciones" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="4">
        <margin top="8" left="12" bottom="8" right="12"/>
        <constraints><grid row="6" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/>
        <border type="line"/>
        <children>
          <component id="b1025" class="javax.swing.JLabel" binding="lblEstado"><constraints><grid row="0" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Estado de búsqueda"/></properties></component>
          <component id="b1026" class="javax.swing.JLabel" binding="lblResumenSeleccion"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Cotización estimada"/></properties></component>
          <component id="b1027" class="javax.swing.JButton" binding="btnLimpiar"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Limpiar filtros"/></properties></component>
          <component id="b1028" class="javax.swing.JButton" binding="btnContinuarReserva"><constraints><grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Reservar seleccionado"/></properties></component>
          <component id="b1030" class="javax.swing.JProgressBar" binding="progressBusqueda"><constraints><grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
        </children>
      </grid>
    </children>
  </grid>
</form>
