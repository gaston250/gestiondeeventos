<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.mdp.eventos.view.cliente.DetalleCotizacionDialog">
  <grid id="q1000" binding="rootPanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
    <margin top="18" left="20" bottom="18" right="20"/>
    <constraints><xy x="20" y="20" width="1020" height="740"/></constraints>
    <properties/><border type="none"/>
    <children>
      <grid id="q1001" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="12" left="14" bottom="12" right="14"/>
        <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="line" title="DATOS DEL EVENTO"/>
        <children><component id="q1002" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Fecha, salón, horario, invitados y tipo de evento"/></properties></component></children>
      </grid>
      <scrollpane id="q1003">
        <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="line" title="SERVICIOS ADICIONALES · MySQL"/>
        <children><component id="q1004" class="javax.swing.JTable"><constraints/><properties/></component></children>
      </scrollpane>
      <grid id="q1005" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="12" left="14" bottom="12" right="14"/>
        <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="line" title="DESGLOSE ESTIMADO"/>
        <children><component id="q1006" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Alquiler por horas + invitados + servicios seleccionados"/></properties></component></children>
      </grid>
      <grid id="q1007" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="8">
        <margin top="12" left="14" bottom="12" right="14"/>
        <constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/></constraints>
        <properties/><border type="line" title="CONFIRMACIÓN REQUERIDA"/>
        <children><component id="q1008" class="javax.swing.JLabel"><constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Confirmar solicitud pendiente o cancelar"/></properties></component></children>
      </grid>
    </children>
  </grid>
</form>
